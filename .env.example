# Copy this file to .env and fill in your keys.
#
# All defaults below use FREE APIs that do NOT require a credit/debit card --
# just an email or Google sign-in.

# --- LLM provider ---
# One of: groq (default) | gemini | ollama | anthropic | openai
LLM_PROVIDER=groq

# Groq (default) -- free key, no card: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini -- free key, no card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash

# Ollama -- fully local, no signup or API key at all.
# Install from https://ollama.com, then: `ollama pull llama3.1`
OLLAMA_MODEL=llama3.1

# --- Paid / card-required providers (optional, only if you already have keys) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# --- Web search ---
# No key needed by default -- WebSearchTool uses DuckDuckGo automatically.
# Optional upgrade (free tier, but requires signing up for an account):
TAVILY_API_KEY=your-tavily-api-key
